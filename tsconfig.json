{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "react", "react-dom"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // tests/ankihtml.test.ts is excluded from tsc only: it imports jsdom (whose
  // types force-load lib.dom and pollute the Bun server program's fetch/BodyInit
  // globals). bun test still runs it by glob, with jsdom providing a runtime DOM.
  "exclude": ["web", "tests/ankihtml.test.ts", "tests/splitanswer.test.ts"]
}
